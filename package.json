    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.7",
    "postcss": "^8.5.1",
    "wrangler": "^4.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
