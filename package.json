{
  "name": "rx_pad",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Pages patient intake and prescription management for a small medical practice.",
  "author": "Rx Pad",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run tests/unit tests/components",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run tests/unit tests/components tests/integration --coverage",
    "test:e2e": "playwright test",
    "test:ci": "npm run test:coverage && npm run test:e2e",
    "pages:dev": "npm run build && wrangler pages dev out",
    "seed:local:test": "node scripts/seed-local-test-db.mjs"
  },
  "dependencies": {
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260329.1",
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.14",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.8",
    "sql.js": "^1.13.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.78.0"
  }
}
